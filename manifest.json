{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "0.1.0",
  "author": "seigwen",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "dualtran@seigwen.dev",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "scripting",
    "compose",
    "messagesRead",
    "storage"
  ],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://models.dev/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "64": "icons/64.png",
    "128": "icons/128.png"
  }
}
